# Copy this file to ".env" and fill in real values. Never commit .env.

# "development" locally, "production" when deployed.
ENVIRONMENT=development

# PostgreSQL connection string. This default matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/growth_tracker

# Used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# How long a login lasts, in minutes (10080 = 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend address(es) allowed to call this API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173
